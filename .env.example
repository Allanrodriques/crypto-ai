# ---------------------------------------------------------------------------
# V1 does NOT require any credentials.
#
# Binance public market-data endpoints (https://data-api.binance.vision) serve
# historical klines without an API key. This file exists so that V2+ (order
# placement, authenticated account data) has an obvious, git-ignored home for
# secrets, and so a developer can override the default data host here.
# ---------------------------------------------------------------------------

# Optional: override the public market-data base URL.
#   - data-api.binance.vision : market-data only, no key, no trading perms  (default)
#   - api.binance.com         : main API, klines are public, no key needed
BINANCE_BASE_URL=https://data-api.binance.vision

# Only required for authenticated endpoints in a future version.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
